---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Página no encontrada | Cloak Studio" path="/404" noindex>
  <section class="container notfound">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p class="lead">Puede que el enlace haya cambiado. Vuelve al inicio o cuéntanos qué buscabas.</p>
    <div class="notfound__actions">
      <Button href="/">Volver al inicio</Button>
      <Button href="/#contacto" variant="secondary">Contactar</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding-block: var(--space-section);
    min-height: 60vh;
    align-content: center;
  }
  h1 {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    max-width: 14ch;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>

---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import plate from '../assets/hero/plate.webp';
import laptop from '../assets/hero/laptop.webp';
import phone from '../assets/hero/phone.webp';
import card from '../assets/hero/card.webp';
import planet from '../assets/hero/planet.webp';
import asteroid1 from '../assets/hero/asteroid1.webp';
import asteroid2 from '../assets/hero/asteroid2.webp';
import layerData from '../assets/hero/layers.json';
import { getLang, ui } from '../i18n/ui';

const t = ui[getLang(Astro)].hero;
import heroGround from '../assets/cosmos/hero-ground.webp';

// Piezas móviles de la escena (recortes de Diseño/principal.jpeg, ver
// scripts/build-design-assets.mjs). Posición en % del recorte de 734×452.
const { width: SW, height: SH, layers } = layerData;
const images = { laptop, phone, card, planet, asteroid1, asteroid2 } as const;
const pieces = (Object.keys(images) as (keyof typeof images)[]).map((name) => {
  const l = layers[name];
  const pct = (v: number, t: number) => `${((v / t) * 100).toFixed(3)}%`;
  return {
    name,
    src: images[name],
    style: `left:${pct(l.x, SW)};top:${pct(l.y, SH)};width:${pct(l.w, SW)}`,
    // Centro de la pieza: origen de su giro.
    origin: `--ox:${pct(l.x + l.w / 2, SW)};--oy:${pct(l.y + l.h / 2, SH)}`,
  };
});

// Estrellas del fondo que centellean (px del recorte).
const glints = [
  [118, 70, 1], [300, 18, 0.8], [575, 240, 1.1], [712, 300, 0.8], [40, 205, 0.9], [440, 400, 0.7],
] as const;
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-cosmos-anchor="hero">
  <div class="frame hero__frame">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{t.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">{t.line1}</span>
        <span class="hero__line" style="--delay:0.25s">{t.line2}<span class="hero__dot">.</span></span>
        <span class="hero__accent" style="--delay:0.5s">
          <span>{t.accent1}</span>
          <span>{t.accent2}<span class="hero__dot">.</span></span>
        </span>
      </h1>
      <p class="hero__lead">{t.lead}</p>
      <div class="hero__actions">
        <Button href="#servicios" class="hero__btn">
          {t.explore}
          <Icon name="arrow-down" size={16} />
        </Button>
        <Button href="#contacto" variant="secondary" class="hero__btn">{t.tellUs}</Button>
      </div>
    </div>

    <!-- Resplandor de horizonte detrás de la corteza -->
    <span class="hero__horizon" aria-hidden="true"></span>

    <!-- Corteza rocosa a todo el ancho (Diseño/principal.jpeg, y 392–561). Decorativa. -->
    <Image
      src={heroGround}
      alt=""
      class="hero__ground"
      widths={[1170, 2340]}
      sizes="80rem"
      quality={88}
      format="webp"
      loading="eager"
    />

    <!-- Escena del diseño de referencia (recorte de Diseño/principal.jpeg). Decorativa. -->
    <div class="hero__visual" aria-hidden="true">
      <!-- Fondo: portal, roca y nebulosa (las piezas móviles van encima) -->
      <Image
        src={plate}
        alt=""
        class="hero__scene"
        widths={[734, 1100, 1468, 2202]}
        sizes="(min-width: 64rem) 52rem, 100vw"
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />

      <!-- Luz del portal que respira -->
      <span class="hero__portal-glow"></span>

      <!-- Estela que recorre la órbita (pasa por detrás del portátil y del móvil) -->
      <svg class="hero__orbit" viewBox="0 0 734 452" preserveAspectRatio="none">
        <g transform="rotate(-9 346 262)">
          <path class="hero__trail hero__trail--3" d="M48 262a298 44 0 1 0 596 0a298 44 0 1 0 -596 0" pathLength="1000" />
          <path class="hero__trail hero__trail--2" d="M48 262a298 44 0 1 0 596 0a298 44 0 1 0 -596 0" pathLength="1000" />
          <path class="hero__trail hero__trail--1" d="M48 262a298 44 0 1 0 596 0a298 44 0 1 0 -596 0" pathLength="1000" />
        </g>
      </svg>

      <!-- Piezas que flotan; los textos de las pantallas se mueven con ellas -->
      {
        pieces.map((p) => (
          <div class:list={['layer', `layer--${p.name}`]} style={p.origin}>
            <Image src={p.src} alt="" class="layer__img" style={p.style} quality={92} format="webp" loading="eager" />
            {p.name === 'laptop' && (
              <span class="screen-text screen-text--laptop">
                {t.laptop[0]}
                <br />
                {t.laptop[1]}<span>{t.laptop[2]}</span>
              </span>
            )}
            {p.name === 'card' && (
              <>
                <span class="screen-text screen-text--metric">12.5k</span>
                <span class="screen-text screen-text--trend">↗ +12.5%</span>
              </>
            )}
            {p.name === 'phone' && (
              <span class="screen-text screen-text--phone">
                {t.phone[0]}
                <br />
                {t.phone[1]}
              </span>
            )}
          </div>
        ))
      }

      {
        glints.map(([x, y, sz], i) => (
          <span
            class="glint"
            style={`left:${((x / SW) * 100).toFixed(2)}%;top:${((y / SH) * 100).toFixed(2)}%;--s:${sz};--d:${(i * 0.7).toFixed(1)}s`}
          />
        ))
      }
    </div>

  </div>
</section>

<style>
  /*
   * --k = 1 px de Diseño/principal.jpeg. En la referencia la cabecera mide 904 px
   * (x 133–1037) y aquí ocupa la fila de contenido: todo el hero escala con ella.
   */
  .hero {
    --row: min(100vw - var(--frame-pad) * 2, var(--row-max));
    --k: calc(var(--row) / 904);
    position: relative;
    overflow-x: clip;
    padding-top: calc(var(--header-height) + clamp(2.5rem, 1.5rem + 5vw, 4rem));
  }

  .hero__frame {
    position: relative;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }


  .hero__title {
    margin-top: var(--space-5);
    font-family: var(--font-brand);
    font-size: clamp(2.6rem, 1.2rem + 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.028em;
    word-spacing: 0.08em;
    text-wrap: initial;
  }

  .hero__title > span,
  .hero__accent > span {
    display: block;
  }

  /* El punto de Plus Jakarta lleva mucho espaciado a la izquierda */
  .hero__dot {
    margin-left: -0.07em;
  }

  /* Lavanda metalizado: misma familia violeta de la marca */
  /*
   * Brillo del titular: un destello violeta-blanco recorre las letras cada pocos
   * segundos (escalonado por línea) y un halo violeta suave las ilumina.
   */
  .hero__title {
    --shine: linear-gradient(
      105deg,
      transparent 0 41%,
      rgb(185 147 255 / 0.9) 46%,
      #fbf8ff 50%,
      rgb(185 147 255 / 0.9) 54%,
      transparent 59% 100%
    );
    --shine-bright: linear-gradient(
      105deg,
      transparent 0 40%,
      rgb(255 255 255 / 0.7) 47%,
      #fff 50%,
      rgb(255 255 255 / 0.7) 53%,
      transparent 60% 100%
    );
    position: relative;
  }

  /* Resplandor violeta detrás del titular, con un latido lento */
  .hero__title::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18% -22% -12% -14%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.16), rgb(139 92 246 / 0.05) 55%, transparent);
    pointer-events: none;
    animation: hero-glow 5.5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow {
    from {
      opacity: 0.45;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .hero__line,
  .hero__accent {
    width: fit-content;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-repeat: no-repeat;
    background-size: 250% 100%, 100% 100%;
    background-position: 100% 0, 0 0;
    animation: hero-shine 7s cubic-bezier(0.45, 0, 0.25, 1) var(--delay, 0s) infinite;
  }

  /* Hueco para los descendentes (g, q): el texto recortado no sale de su caja */
  .hero__line {
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
    background-image: var(--shine), linear-gradient(#f7f5fa, #f7f5fa);
  }

  /* Un único degradado para las dos líneas (colores medidos en la referencia) */
  .hero__accent {
    background-image: var(--shine-bright),
      linear-gradient(180deg, #ece3fe 0%, #d2bcfc 30%, #b897fa 62%, #9c6ef6 100%);
    padding-bottom: 0.18em;
    margin-bottom: -0.12em;
  }

  @keyframes hero-shine {
    0% {
      background-position: 100% 0, 0 0;
    }
    38%,
    100% {
      background-position: 0% 0, 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__accent,
    .hero__title::before {
      animation: none;
      background-position: 100% 0, 0 0;
    }
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: 26.5rem;
    font-size: var(--text-md);
    line-height: 1.66;
    color: var(--color-copy);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__actions :global(.hero__btn) {
    min-height: 2.75rem;
    padding: 0.7rem 1.45rem;
    font-size: 0.9375rem;
  }

  .hero__visual {
    position: relative;
    margin: var(--space-6) calc(var(--frame-pad) * -1) 0;
    aspect-ratio: 734 / 452;
    pointer-events: none;
    user-select: none;
    /* Fondo de la escena = fondo de la web; el alfa del recorte la funde */
  }

  /* La corteza a todo el ancho solo se ve en escritorio (en móvil la escena ya lleva su roca) */
  .hero__ground,
  .hero__horizon {
    display: none;
  }

  .hero__scene {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* El tamaño de los textos sigue al de la escena (unidades del contenedor) */
  .hero__visual {
    container-type: inline-size;
  }

  .screen-text {
    position: absolute;
    font-family: var(--font-brand);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: #f5f3fb;
    transform-origin: 0 0;
  }

  /* Portátil: x 626, y 222 de la referencia; pantalla girada y en perspectiva */
  .screen-text--laptop {
    left: 25.4%;
    top: 42%;
    font-size: 2.05cqw;
    word-spacing: 0.06em;
    transform: rotate(12.5deg) skewX(18deg);
  }

  .screen-text--laptop span {
    color: #a98bfa;
  }

  /* Móvil: x 898, y 251 */
  .screen-text--phone {
    left: 63.5%;
    top: 48.9%;
    font-size: 1.62cqw;
    font-weight: 600;
    word-spacing: 0.12em;
    transform: rotate(7.5deg) skewX(-11deg);
  }

  /* Tarjeta de métricas: x 393, y 136 del recorte */
  .screen-text--metric {
    left: 53.6%;
    top: 29.8%;
    font-size: 1.54cqw;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .screen-text--trend {
    left: 53.68%;
    top: 33.1%;
    font-family: var(--font-body);
    font-size: 0.74cqw;
    font-weight: 600;
    line-height: 1;
    color: #2dd4bf;
  }

  /* ── Escena por capas ─────────────────────────────────────── */
  .layer {
    position: absolute;
    inset: 0;
    transform-origin: var(--ox) var(--oy);
  }

  .layer__img {
    position: absolute;
    height: auto;
    max-width: none;
  }

  .layer--laptop {
    animation: float-a 7s ease-in-out infinite alternate;
  }

  .layer--phone {
    animation: float-b 6s ease-in-out -2.5s infinite alternate;
  }

  .layer--card {
    animation: float-c 8s ease-in-out -4s infinite alternate;
  }

  .layer--planet {
    animation: float-planet 16s ease-in-out infinite alternate;
  }

  .layer--asteroid1 {
    animation: drift-a 11s ease-in-out infinite alternate;
  }

  .layer--asteroid2 {
    animation: drift-b 13s ease-in-out -5s infinite alternate;
  }

  /* Portátil y móvil: flotación marcada (≈ 1,5 % del ancho de la escena) */
  @keyframes float-a {
    from { transform: translate(-0.15cqw, 0.75cqw) rotate(0.6deg); }
    to { transform: translate(0.2cqw, -0.85cqw) rotate(-0.8deg); }
  }

  @keyframes float-b {
    from { transform: translate(0.15cqw, -0.7cqw) rotate(-1deg); }
    to { transform: translate(-0.2cqw, 0.9cqw) rotate(1.1deg); }
  }

  @keyframes float-c {
    from { transform: translate(-0.15cqw, 0.25cqw); }
    to { transform: translate(0.2cqw, -0.35cqw); }
  }

  @keyframes float-planet {
    from { transform: translate(0, 0) rotate(0deg); }
    to { transform: translate(-0.35cqw, 0.3cqw) rotate(-2deg); }
  }

  @keyframes drift-a {
    from { transform: translate(0, 0) rotate(-6deg); }
    to { transform: translate(0.4cqw, -0.5cqw) rotate(10deg); }
  }

  @keyframes drift-b {
    from { transform: translate(0, 0) rotate(8deg); }
    to { transform: translate(-0.5cqw, -0.35cqw) rotate(-8deg); }
  }

  /* Luz del portal: interior ≈ x 210–470, y 25–380 del recorte */
  .hero__portal-glow {
    position: absolute;
    left: 28%;
    top: 6%;
    width: 38%;
    height: 78%;
    background: radial-gradient(closest-side, rgb(167 139 250 / 0.28), rgb(124 58 237 / 0.1) 55%, transparent);
    mix-blend-mode: screen;
    animation: portal-breathe 5.5s ease-in-out infinite alternate;
  }

  @keyframes portal-breathe {
    from { opacity: 0.25; transform: scale(0.97); }
    to { opacity: 1; transform: scale(1.03); }
  }

  /* Estela de la órbita: tres tramos que terminan en la cabeza del cometa */
  .hero__orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .hero__trail {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    animation: orbit-run 12s linear infinite;
  }

  .hero__trail--1 { stroke: #fff; stroke-width: 2.2; stroke-dasharray: 18 982; --len: 18; filter: drop-shadow(0 0 4px #c4b5fd); }
  .hero__trail--2 { stroke: #c4b5fd; stroke-width: 1.6; stroke-dasharray: 55 945; opacity: 0.6; --len: 55; }
  .hero__trail--3 { stroke: #8b5cf6; stroke-width: 1.2; stroke-dasharray: 120 880; opacity: 0.35; --len: 120; }

  @keyframes orbit-run {
    from { stroke-dashoffset: var(--len); }
    to { stroke-dashoffset: calc(var(--len) - 1000); }
  }

  /* Destellos de cuatro puntas sobre estrellas del fondo */
  .glint {
    position: absolute;
    width: calc(1.9cqw * var(--s));
    height: calc(1.9cqw * var(--s));
    translate: -50% -50%;
    background:
      radial-gradient(closest-side, #fff, rgb(221 214 254 / 0.5) 22%, transparent),
      linear-gradient(to right, transparent, #fff 50%, transparent) center / 100% 1px no-repeat,
      linear-gradient(to bottom, transparent, #fff 50%, transparent) center / 1px 100% no-repeat;
    mix-blend-mode: screen;
    animation: glint 3.6s ease-in-out var(--d) infinite;
  }

  @keyframes glint {
    0%, 100% { opacity: 0.15; transform: scale(0.5); }
    50% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .layer,
    .hero__portal-glow,
    .glint {
      animation: none;
    }

    .hero__trail {
      display: none;
    }
  }


  @media (min-width: 40rem) {
    .hero__actions {
      flex-wrap: nowrap;
    }
  }

  /* ── Escritorio: composición de Diseño/principal.jpeg (medidas en px de la referencia) ── */
  @media (min-width: 64rem) {
    /* La cabecera de la referencia está a y=9; el antetítulo a y=93 */
    /* Alto de la escena (y 26–478 de la referencia): la sección termina tras la roca */
    .hero {
      padding-top: calc(var(--header-height) / 2 + 76 * var(--k));
      padding-bottom: calc(78 * var(--k));
    }

    .hero__frame {
      max-width: calc(var(--row-max) + var(--frame-pad) * 2);
    }

    .hero__eyebrow {
      font-size: calc(8.1 * var(--k));
      letter-spacing: 0.065em;
      color: #c47ef6;
    }

    .hero__eyebrow::before {
      width: calc(17 * var(--k));
      background: #a46cf2;
    }

    .hero__title {
      margin-top: calc(13 * var(--k));
      font-size: calc(55.5 * var(--k));
      line-height: calc(51.2 / 55.5);
      letter-spacing: -0.03em;
    }

    .hero__lead {
      margin-top: calc(18 * var(--k));
      max-width: calc(332 * var(--k));
      font-size: calc(13.5 * var(--k));
      line-height: calc(20.6 / 14.4);
    }

    .hero__actions {
      margin-top: calc(25 * var(--k));
      gap: calc(9 * var(--k));
    }

    .hero__actions :global(.hero__btn) {
      min-height: calc(32 * var(--k));
      padding: 0 calc(16 * var(--k));
      gap: calc(8 * var(--k));
      font-size: calc(10.2 * var(--k));
      font-weight: 500;
    }

    /*
     * Corteza: x 0–1170, y 392–561 de la referencia, con el mismo desplazamiento
     * que la escena (y_ref − 61) para que su roca coincida con la del portal.
     */
    .hero__ground {
      display: block;
      position: absolute;
      z-index: 0;
      left: calc(var(--frame-pad) - 133 * var(--k));
      top: calc(331 * var(--k));
      width: calc(1170 * var(--k));
      height: auto;
      pointer-events: none;
      user-select: none;
      -webkit-mask-image:
        linear-gradient(to right, transparent 30%, #000 47%, #000 90%, transparent),
        linear-gradient(to bottom, #000 72%, transparent);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 30%, #000 47%, #000 90%, transparent),
        linear-gradient(to bottom, #000 72%, transparent);
      mask-composite: intersect;
    }

    /* Luz violeta que asoma tras el horizonte rocoso y se disuelve en el cielo */
    .hero__horizon {
      display: block;
      position: absolute;
      z-index: 0;
      left: calc(var(--frame-pad) - 133 * var(--k));
      top: calc(250 * var(--k));
      width: calc(1170 * var(--k));
      height: calc(230 * var(--k));
      pointer-events: none;
      background:
        radial-gradient(42% 38% at 62% 62%, rgb(124 58 237 / 0.26), transparent 72%),
        radial-gradient(60% 30% at 40% 70%, rgb(91 33 182 / 0.16), transparent 75%);
    }

    /* Recorte x 436–1170, y 26–478 de la referencia */
    .hero__visual {
      position: absolute;
      z-index: 0;
      left: calc(var(--frame-pad) + 303 * var(--k));
      /* Algo más abajo que en la referencia para separarla de la cabecera */
      top: calc(-35 * var(--k));
      width: calc(734 * var(--k));
      margin: 0;
      /* El fundido elíptico va en el alfa del propio recorte */
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>

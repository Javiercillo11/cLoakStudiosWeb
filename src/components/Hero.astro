---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import heroScene from '../assets/cosmos/hero-scene.png';
import { services } from '../data/services';

// Estrellas de la propia imagen (px del recorte de 876×720) que centellean.
const glints = [
  { x: 105, y: 157, s: 1, d: '0s' },
  { x: 152, y: 350, s: 1.35, d: '1.3s' },
  { x: 827, y: 364, s: 1.1, d: '2.1s' },
  { x: 776, y: 205, s: 0.75, d: '0.6s' },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-cosmos-anchor="hero">
  <div class="frame hero__frame">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Estudio independiente de desarrollo digital</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">Digitalizamos</span>
        <span class="hero__line" style="--delay:0.25s">tu negocio<span class="hero__dot">.</span></span>
        <span class="hero__accent" style="--delay:0.5s">
          <span>Construimos</span>
          <span>lo que viene<span class="hero__dot">.</span></span>
        </span>
      </h1>
      <p class="hero__lead">
        Creamos páginas web, aplicaciones de gestión y soluciones digitales para ayudar a los negocios a trabajar mejor y
        crecer.
      </p>
      <div class="hero__actions">
        <Button href="#servicios" class="hero__btn">
          Explorar servicios
          <Icon name="arrow-down" size={16} />
        </Button>
        <Button href="#contacto" variant="secondary" class="hero__btn">Cuéntanos tu proyecto</Button>
      </div>
    </div>

    <!-- Escena del diseño de referencia (recorte de Diseño/1.png, x≥445). Decorativa. -->
    <div class="hero__visual" aria-hidden="true">
      <Image
        src={heroScene}
        alt=""
        class="hero__scene"
        quality={95}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero__pulse"></span>
      {
        glints.map((g) => (
          <span
            class="glint"
            style={`left:${((g.x / 876) * 100).toFixed(2)}%;top:${((g.y / 720) * 100).toFixed(2)}%;--s:${g.s};--d:${g.d}`}
          />
        ))
      }
    </div>

    <ul role="list" class="hero__index" aria-label="Servicios">
      {
        services.map((s) => (
          <li>
            <a href={`#${s.slug}`}>
              <span class="hero__index-num">{s.number}</span>
              {s.title}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /*
   * --u = 1 px de la composición de referencia (1321 px de ancho). En escritorio
   * todo el hero escala con él para conservar exactamente las proporciones.
   */
  .hero {
    --u: calc(min(100vw, 82.5rem) / 1321);
    position: relative;
    overflow-x: clip;
    padding-top: calc(var(--header-height) + clamp(2.5rem, 1.5rem + 5vw, 4rem));
  }

  .hero__frame {
    position: relative;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }


  .hero__title {
    margin-top: var(--space-5);
    font-family: var(--font-brand);
    font-size: clamp(2.6rem, 1.2rem + 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.028em;
    word-spacing: 0.08em;
    text-wrap: initial;
  }

  .hero__title > span,
  .hero__accent > span {
    display: block;
  }

  /* El punto de Plus Jakarta lleva mucho espaciado a la izquierda */
  .hero__dot {
    margin-left: -0.07em;
  }

  /* Lavanda metalizado: misma familia violeta de la marca */
  /*
   * Brillo del titular: un destello violeta-blanco recorre las letras cada pocos
   * segundos (escalonado por línea) y un halo violeta suave las ilumina.
   */
  .hero__title {
    --shine: linear-gradient(
      105deg,
      transparent 0 41%,
      rgb(185 147 255 / 0.9) 46%,
      #fbf8ff 50%,
      rgb(185 147 255 / 0.9) 54%,
      transparent 59% 100%
    );
    --shine-bright: linear-gradient(
      105deg,
      transparent 0 40%,
      rgb(255 255 255 / 0.7) 47%,
      #fff 50%,
      rgb(255 255 255 / 0.7) 53%,
      transparent 60% 100%
    );
    position: relative;
  }

  /* Resplandor violeta detrás del titular, con un latido lento */
  .hero__title::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18% -22% -12% -14%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.16), rgb(139 92 246 / 0.05) 55%, transparent);
    pointer-events: none;
    animation: hero-glow 5.5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow {
    from {
      opacity: 0.45;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .hero__line,
  .hero__accent {
    width: fit-content;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-repeat: no-repeat;
    background-size: 250% 100%, 100% 100%;
    background-position: 100% 0, 0 0;
    animation: hero-shine 7s cubic-bezier(0.45, 0, 0.25, 1) var(--delay, 0s) infinite;
  }

  .hero__line {
    background-image: var(--shine), linear-gradient(#f7f5fa, #f7f5fa);
  }

  /* Un único degradado para las dos líneas (colores medidos en la referencia) */
  .hero__accent {
    background-image: var(--shine-bright),
      linear-gradient(155deg, #f1ebfc 0%, #e2d6fb 28%, #c9b2fb 52%, #b892fa 76%, #a77df8 100%);
    padding-bottom: 0.06em;
  }

  @keyframes hero-shine {
    0% {
      background-position: 100% 0, 0 0;
    }
    38%,
    100% {
      background-position: 0% 0, 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__accent,
    .hero__title::before {
      animation: none;
      background-position: 100% 0, 0 0;
    }
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: 26.5rem;
    font-size: var(--text-md);
    line-height: 1.66;
    color: var(--color-copy);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__actions :global(.hero__btn) {
    min-height: 2.75rem;
    padding: 0.7rem 1.45rem;
    font-size: 0.9375rem;
  }

  .hero__visual {
    position: relative;
    margin: var(--space-4) calc(var(--frame-pad) * -1) 0;
    aspect-ratio: 876 / 720;
    pointer-events: none;
    user-select: none;
    /* Bordes fundidos con la galaxia animada */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 3%, #000 94%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 86%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 3%, #000 94%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 86%, transparent);
    mask-composite: intersect;
  }

  .hero__scene {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Respiración de la luz violeta del portátil */
  .hero__pulse {
    position: absolute;
    left: 20%;
    top: 12%;
    width: 72%;
    height: 78%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.22), transparent);
    mix-blend-mode: screen;
    animation: hero-pulse 6s ease-in-out infinite alternate;
  }

  @keyframes hero-pulse {
    from {
      opacity: 0.15;
    }
    to {
      opacity: 0.85;
    }
  }

  /* Destello de cuatro puntas sobre las estrellas de la imagen */
  .glint {
    position: absolute;
    width: calc(28px * var(--s));
    height: calc(28px * var(--s));
    translate: -50% -50%;
    background:
      radial-gradient(closest-side, rgb(255 255 255 / 0.95), rgb(221 214 254 / 0.5) 18%, rgb(139 92 246 / 0.15) 45%, transparent),
      linear-gradient(to right, transparent, rgb(255 255 255 / 0.9) 50%, transparent) center / 100% 1px no-repeat,
      linear-gradient(to bottom, transparent, rgb(255 255 255 / 0.9) 50%, transparent) center / 1px 100% no-repeat;
    mix-blend-mode: screen;
    animation: glint 3.6s ease-in-out var(--d) infinite;
  }

  @keyframes glint {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.55) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: scale(1) rotate(8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse,
    .glint {
      animation: none;
    }
  }

  .hero__index {
    position: relative;
    z-index: 1;
    display: grid;
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .hero__index a {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    padding: 1.15rem 0;
    color: #c7c8d4;
    font-size: 0.8125rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    transition: color var(--duration-fast) ease;
  }

  .hero__index a:hover {
    color: var(--text);
  }

  .hero__index-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: #9d70f4;
  }

  @media (min-width: 40rem) {
    .hero__actions {
      flex-wrap: nowrap;
    }
  }

  /* ── Escritorio: composición fiel a la referencia ───────────── */
  @media (min-width: 64rem) {
    .hero {
      padding-top: calc(142 * var(--u));
    }

    /* Centrado: el marco del hero se ajusta a la fila de contenido (64rem);
       la escena conserva su posición relativa al texto (x = texto + 417). */
    .hero__frame {
      max-width: calc(var(--row-max) + var(--frame-pad) * 2);
    }

    .hero__eyebrow {
      font-size: max(0.5625rem, calc(9.8 * var(--u)));
      letter-spacing: 0.155em;
    }

    .hero__title {
      margin-top: calc(9 * var(--u));
      font-size: calc(66.5 * var(--u));
      line-height: calc(72 / 66.5);
    }

    .hero__lead {
      margin-top: calc(11 * var(--u));
      max-width: calc(415 * var(--u));
      font-size: max(0.875rem, calc(17.4 * var(--u)));
    }

    .hero__actions {
      margin-top: calc(35 * var(--u));
      gap: calc(15 * var(--u));
    }

    .hero__actions :global(.hero__btn) {
      min-height: calc(44 * var(--u));
      padding: 0 calc(22 * var(--u));
      gap: calc(10 * var(--u));
      font-size: max(0.8125rem, calc(13.2 * var(--u)));
    }

    /* Mismo sitio que en la referencia: x=445, y=0 (el marco empieza en y=142) */
    .hero__visual {
      position: absolute;
      z-index: 0;
      left: calc(445 * var(--u));
      top: calc(-142 * var(--u));
      width: calc(876 * var(--u));
      aspect-ratio: 876 / 720;
      margin: 0;
      /* Vertical ∩ (fundido izquierdo amplio ∪ zona opaca en la punta de la base) */
      -webkit-mask-image:
        linear-gradient(to bottom, #000 90%, transparent),
        linear-gradient(to right, transparent, #000 16%, var(--right-fade, #000 100%)),
        radial-gradient(14% 8.5% at 7% 74.5%, #000 55%, transparent);
      -webkit-mask-composite: source-in, source-over;
      mask-image:
        linear-gradient(to bottom, #000 90%, transparent),
        linear-gradient(to right, transparent, #000 16%, var(--right-fade, #000 100%)),
        radial-gradient(14% 8.5% at 7% 74.5%, #000 55%, transparent);
      mask-composite: intersect, add;
    }

    /* Solo cuando la pantalla es más ancha que la referencia: fundir el borde derecho */
    @media (min-width: 83rem) {
      .hero__visual {
        --right-fade: #000 80%, transparent;
      }
    }

    .hero__index {
      margin-top: calc(79 * var(--u));
      max-width: calc(1002 * var(--u));
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__index a {
      border-bottom: 0;
      gap: calc(16 * var(--u));
      padding: calc(16.5 * var(--u)) calc(20 * var(--u)) calc(26 * var(--u));
      font-size: max(0.75rem, calc(12.2 * var(--u)));
    }

    .hero__index li + li a {
      border-left: 1px solid var(--color-line);
    }

    .hero__index li:first-child a {
      padding-left: 0;
    }
  }
</style>

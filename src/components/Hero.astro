---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import heroPortal from '../assets/cosmos/hero-portal.webp';
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-cosmos-anchor="hero">
  <div class="frame hero__frame">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Estudio independiente de desarrollo digital</p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">Digitalizamos</span>
        <span class="hero__line" style="--delay:0.25s">tu negocio<span class="hero__dot">.</span></span>
        <span class="hero__accent" style="--delay:0.5s">
          <span>Construimos</span>
          <span>lo que viene<span class="hero__dot">.</span></span>
        </span>
      </h1>
      <p class="hero__lead">
        Creamos páginas web, aplicaciones de gestión y soluciones digitales para ayudar a los negocios a trabajar mejor y
        crecer.
      </p>
      <div class="hero__actions">
        <Button href="#servicios" class="hero__btn">
          Explorar servicios
          <Icon name="arrow-down" size={16} />
        </Button>
        <Button href="#contacto" variant="secondary" class="hero__btn">Cuéntanos tu proyecto</Button>
      </div>
    </div>

    <!-- Escena del diseño de referencia (recorte de Diseño/principal.jpeg). Decorativa. -->
    <div class="hero__visual" aria-hidden="true">
      <Image
        src={heroPortal}
        alt=""
        class="hero__scene"
        widths={[734, 1100, 1468]}
        sizes="(min-width: 64rem) 52rem, 100vw"
        quality={90}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Textos de las pantallas en HTML (nítidos a cualquier tamaño) -->
      <span class="screen-text screen-text--laptop">Ideas que<br />conec<span>tan.</span></span>
      <span class="screen-text screen-text--phone">Deja tu<br />reseña</span>
    </div>

  </div>
</section>

<style>
  /*
   * --k = 1 px de Diseño/principal.jpeg. En la referencia la cabecera mide 904 px
   * (x 133–1037) y aquí ocupa la fila de contenido: todo el hero escala con ella.
   */
  .hero {
    --row: min(100vw - var(--frame-pad) * 2, var(--row-max));
    --k: calc(var(--row) / 904);
    position: relative;
    overflow-x: clip;
    padding-top: calc(var(--header-height) + clamp(2.5rem, 1.5rem + 5vw, 4rem));
  }

  .hero__frame {
    position: relative;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }


  .hero__title {
    margin-top: var(--space-5);
    font-family: var(--font-brand);
    font-size: clamp(2.6rem, 1.2rem + 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.028em;
    word-spacing: 0.08em;
    text-wrap: initial;
  }

  .hero__title > span,
  .hero__accent > span {
    display: block;
  }

  /* El punto de Plus Jakarta lleva mucho espaciado a la izquierda */
  .hero__dot {
    margin-left: -0.07em;
  }

  /* Lavanda metalizado: misma familia violeta de la marca */
  /*
   * Brillo del titular: un destello violeta-blanco recorre las letras cada pocos
   * segundos (escalonado por línea) y un halo violeta suave las ilumina.
   */
  .hero__title {
    --shine: linear-gradient(
      105deg,
      transparent 0 41%,
      rgb(185 147 255 / 0.9) 46%,
      #fbf8ff 50%,
      rgb(185 147 255 / 0.9) 54%,
      transparent 59% 100%
    );
    --shine-bright: linear-gradient(
      105deg,
      transparent 0 40%,
      rgb(255 255 255 / 0.7) 47%,
      #fff 50%,
      rgb(255 255 255 / 0.7) 53%,
      transparent 60% 100%
    );
    position: relative;
  }

  /* Resplandor violeta detrás del titular, con un latido lento */
  .hero__title::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -18% -22% -12% -14%;
    background: radial-gradient(closest-side, rgb(139 92 246 / 0.16), rgb(139 92 246 / 0.05) 55%, transparent);
    pointer-events: none;
    animation: hero-glow 5.5s ease-in-out infinite alternate;
  }

  @keyframes hero-glow {
    from {
      opacity: 0.45;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .hero__line,
  .hero__accent {
    width: fit-content;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-repeat: no-repeat;
    background-size: 250% 100%, 100% 100%;
    background-position: 100% 0, 0 0;
    animation: hero-shine 7s cubic-bezier(0.45, 0, 0.25, 1) var(--delay, 0s) infinite;
  }

  /* Hueco para los descendentes (g, q): el texto recortado no sale de su caja */
  .hero__line {
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
    background-image: var(--shine), linear-gradient(#f7f5fa, #f7f5fa);
  }

  /* Un único degradado para las dos líneas (colores medidos en la referencia) */
  .hero__accent {
    background-image: var(--shine-bright),
      linear-gradient(180deg, #ece3fe 0%, #d2bcfc 30%, #b897fa 62%, #9c6ef6 100%);
    padding-bottom: 0.18em;
    margin-bottom: -0.12em;
  }

  @keyframes hero-shine {
    0% {
      background-position: 100% 0, 0 0;
    }
    38%,
    100% {
      background-position: 0% 0, 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__accent,
    .hero__title::before {
      animation: none;
      background-position: 100% 0, 0 0;
    }
  }

  .hero__lead {
    margin-top: var(--space-6);
    max-width: 26.5rem;
    font-size: var(--text-md);
    line-height: 1.66;
    color: var(--color-copy);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__actions :global(.hero__btn) {
    min-height: 2.75rem;
    padding: 0.7rem 1.45rem;
    font-size: 0.9375rem;
  }

  .hero__visual {
    position: relative;
    margin: var(--space-6) calc(var(--frame-pad) * -1) 0;
    aspect-ratio: 734 / 452;
    pointer-events: none;
    user-select: none;
    /* Fondo de la escena = fondo de la web; el alfa del recorte la funde */
  }

  .hero__scene {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* El tamaño de los textos sigue al de la escena (unidades del contenedor) */
  .hero__visual {
    container-type: inline-size;
  }

  .screen-text {
    position: absolute;
    font-family: var(--font-brand);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: #f5f3fb;
    transform-origin: 0 0;
  }

  /* Portátil: x 626, y 222 de la referencia; pantalla girada y en perspectiva */
  .screen-text--laptop {
    left: 25.4%;
    top: 42%;
    font-size: 2.05cqw;
    word-spacing: 0.06em;
    transform: rotate(12.5deg) skewX(18deg);
  }

  .screen-text--laptop span {
    color: #a98bfa;
  }

  /* Móvil: x 898, y 251 */
  .screen-text--phone {
    left: 62.6%;
    top: 48.5%;
    font-size: 1.75cqw;
    font-weight: 600;
    transform: rotate(7.5deg) skewX(-16deg);
  }


  @media (min-width: 40rem) {
    .hero__actions {
      flex-wrap: nowrap;
    }
  }

  /* ── Escritorio: composición de Diseño/principal.jpeg (medidas en px de la referencia) ── */
  @media (min-width: 64rem) {
    /* La cabecera de la referencia está a y=9; el antetítulo a y=93 */
    /* Alto de la escena (y 26–478 de la referencia): la sección termina tras la roca */
    .hero {
      padding-top: calc(var(--header-height) / 2 + 76 * var(--k));
      padding-bottom: calc(64 * var(--k));
    }

    .hero__frame {
      max-width: calc(var(--row-max) + var(--frame-pad) * 2);
    }

    .hero__eyebrow {
      font-size: calc(8.1 * var(--k));
      letter-spacing: 0.065em;
      color: #c47ef6;
    }

    .hero__eyebrow::before {
      width: calc(17 * var(--k));
      background: #a46cf2;
    }

    .hero__title {
      margin-top: calc(13 * var(--k));
      font-size: calc(55.5 * var(--k));
      line-height: calc(51.2 / 55.5);
      letter-spacing: -0.03em;
    }

    .hero__lead {
      margin-top: calc(18 * var(--k));
      max-width: calc(332 * var(--k));
      font-size: calc(13.5 * var(--k));
      line-height: calc(20.6 / 14.4);
    }

    .hero__actions {
      margin-top: calc(25 * var(--k));
      gap: calc(9 * var(--k));
    }

    .hero__actions :global(.hero__btn) {
      min-height: calc(32 * var(--k));
      padding: 0 calc(16 * var(--k));
      gap: calc(8 * var(--k));
      font-size: calc(10.2 * var(--k));
      font-weight: 500;
    }

    /* Recorte x 436–1170, y 26–478 de la referencia */
    .hero__visual {
      position: absolute;
      z-index: 0;
      left: calc(var(--frame-pad) + 303 * var(--k));
      /* Algo más abajo que en la referencia para separarla de la cabecera */
      top: calc(-35 * var(--k));
      width: calc(734 * var(--k));
      margin: 0;
      /* El fundido elíptico va en el alfa del propio recorte */
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>

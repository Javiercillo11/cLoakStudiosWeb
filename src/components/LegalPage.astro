---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legalComplete } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string;
}

// Mientras falten datos del titular, la página es un borrador: noindex y fuera del sitemap.
const { title, description, path } = Astro.props;
---

<BaseLayout
  title={`${title}${legalComplete ? '' : ' (borrador)'} | cLoak Studios`}
  description={description}
  path={path}
  noindex={!legalComplete}
>
  <article class="container legal">
    <p class="eyebrow">Legal</p>
    <h1>{title}</h1>

    {
      !legalComplete && (
        <div class="draft" role="note">
          <strong>Documento en preparación.</strong> Los apartados marcados como <mark>pendiente</mark> se completarán
          antes de su versión definitiva.
        </div>
      )
    }

    <slot />
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: calc(44rem + var(--gutter) * 2);
    padding-block: var(--space-16) var(--space-section);
  }

  h1 {
    margin-top: var(--space-4);
    font-size: var(--text-2xl);
  }

  .legal :global(h2) {
    margin-top: var(--space-12);
    font-size: var(--text-lg);
    letter-spacing: -0.01em;
  }

  .legal :global(h3) {
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }

  .legal :global(p),
  .legal :global(ul) {
    margin-top: var(--space-4);
    color: var(--text-muted);
  }

  .legal :global(ul) {
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-2);
  }

  .legal :global(strong) {
    color: var(--text);
  }

  .legal :global(a) {
    color: var(--color-soft-lavender);
  }

  .legal :global(mark) {
    padding: 0.05em 0.4em;
    border-radius: 4px;
    background: var(--color-warning-bg);
    color: var(--color-warning);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .draft {
    margin-top: var(--space-8);
    padding: var(--space-4) var(--space-5);
    border: 1px dashed rgb(252 211 77 / 0.5);
    border-radius: var(--radius-control);
    background: var(--color-warning-bg);
    color: #fde68a;
    font-size: var(--text-sm);
  }

  .draft strong {
    color: #fde68a;
  }

  .legal :global(.updated) {
    margin-top: var(--space-12);
    font-size: var(--text-sm);
  }
</style>

---
// Ilustraciones conceptuales de cada servicio (no representan clientes ni datos reales).
import type { Service } from '../data/services';

interface Props {
  id: Service['id'];
}

const { id } = Astro.props;

// Patrón decorativo tipo QR (no escaneable), determinista para que el build sea estable.
const N = 21;
const modules: [number, number][] = [];
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const inFinder = (x: number, y: number) =>
  (x < 8 && y < 8) || (x > N - 9 && y < 8) || (x < 8 && y > N - 9) || (x > 7 && x < 13 && y > 7 && y < 13);
for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) if (!inFinder(x, y) && rand() > 0.52) modules.push([x, y]);
const cell = 5.2;
const finders = [
  [0, 0],
  [N - 7, 0],
  [0, N - 7],
];
---

<div class="visual" aria-hidden="true">
  {
    id === 'web' && (
      <svg viewBox="0 0 320 180" fill="none">
        <rect x="14" y="16" width="226" height="148" rx="10" fill="#17131F" stroke="rgb(196 181 253 / 0.16)" />
        <circle cx="28" cy="29" r="3" fill="#3F3F46" />
        <circle cx="38" cy="29" r="3" fill="#3F3F46" />
        <circle cx="48" cy="29" r="3" fill="#3F3F46" />
        <rect x="64" y="25" width="120" height="8" rx="4" fill="#27272A" />
        <path d="M14 42h226" stroke="rgb(244 244 245 / 0.08)" />
        <rect x="30" y="62" width="104" height="10" rx="3" fill="#E4E4E7" fill-opacity="0.9" />
        <rect x="30" y="78" width="78" height="10" rx="3" fill="#C4B5FD" />
        <rect x="30" y="98" width="96" height="5" rx="2.5" fill="#52525B" />
        <rect x="30" y="108" width="84" height="5" rx="2.5" fill="#52525B" />
        <rect x="30" y="126" width="52" height="16" rx="8" fill="#8B5CF6" />
        <rect x="148" y="58" width="76" height="88" rx="8" fill="url(#sv-web-img)" />
        <rect x="246" y="46" width="62" height="122" rx="12" fill="#14111C" stroke="rgb(196 181 253 / 0.22)" />
        <rect x="270" y="52" width="14" height="3" rx="1.5" fill="#3F3F46" />
        <rect x="254" y="64" width="46" height="34" rx="5" fill="url(#sv-web-img)" />
        <rect x="254" y="106" width="38" height="6" rx="3" fill="#E4E4E7" fill-opacity="0.85" />
        <rect x="254" y="117" width="30" height="4" rx="2" fill="#52525B" />
        <rect x="254" y="148" width="46" height="12" rx="6" fill="#8B5CF6" />
        <defs>
          <linearGradient id="sv-web-img" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8B5CF6" />
            <stop offset="1" stop-color="#5B21B6" />
          </linearGradient>
        </defs>
      </svg>
    )
  }
  {
    id === 'app' && (
      <svg viewBox="0 0 320 180" fill="none">
        <rect x="14" y="16" width="292" height="148" rx="10" fill="#17131F" stroke="rgb(196 181 253 / 0.16)" />
        <path d="M74 16v148" stroke="rgb(244 244 245 / 0.08)" />
        <rect x="26" y="30" width="36" height="8" rx="4" fill="#C4B5FD" />
        <rect x="26" y="54" width="36" height="5" rx="2.5" fill="#71717A" />
        <rect x="26" y="68" width="30" height="5" rx="2.5" fill="#52525B" />
        <rect x="26" y="82" width="34" height="5" rx="2.5" fill="#52525B" />
        <rect x="26" y="96" width="28" height="5" rx="2.5" fill="#52525B" />
        <rect x="22" y="50" width="4" height="13" rx="2" fill="#8B5CF6" />
        {[0, 1, 2].map((i) => (
          <g>
            <rect x={88 + i * 72} y="30" width="62" height="34" rx="6" fill="#18181B" stroke="rgb(244 244 245 / 0.08)" />
            <rect x={96 + i * 72} y="38" width="26" height="4" rx="2" fill="#52525B" />
            <rect x={96 + i * 72} y="49" width={[34, 22, 30][i]} height="8" rx="3" fill="#E4E4E7" fill-opacity="0.85" />
          </g>
        ))}
        <rect x="88" y="74" width="134" height="78" rx="6" fill="#18181B" stroke="rgb(244 244 245 / 0.08)" />
        {[30, 44, 26, 52, 40, 58, 48].map((h, i) => (
          <rect x={100 + i * 17} y={142 - h} width="9" height={h} rx="2.5" fill={i === 5 ? '#C4B5FD' : i % 2 ? '#8B5CF6' : '#6D28D9'} />
        ))}
        <rect x="230" y="74" width="62" height="78" rx="6" fill="#18181B" stroke="rgb(244 244 245 / 0.08)" />
        {[0, 1, 2, 3].map((i) => (
          <g>
            <circle cx="241" cy={89 + i * 16} r="4" fill={i === 0 ? '#8B5CF6' : '#3F3F46'} />
            <rect x="250" y={87 + i * 16} width={[32, 26, 30, 22][i]} height="4" rx="2" fill="#52525B" />
          </g>
        ))}
      </svg>
    )
  }
  {
    id === 'qr' && (
      <svg viewBox="0 0 320 180" fill="none">
        <rect x="92" y="10" width="136" height="160" rx="14" fill="#17131F" stroke="rgb(196 181 253 / 0.2)" />
        <g transform="translate(105 23)">
          <rect width={N * cell + 10} height={N * cell + 10} x="-5" y="-5" rx="8" fill="#F4F4F5" />
          {modules.map(([x, y]) => (
            <rect x={x * cell} y={y * cell} width={cell - 0.6} height={cell - 0.6} rx="1" fill="#18181B" />
          ))}
          {finders.map(([fx, fy]) => (
            <g>
              <rect x={fx * cell} y={fy * cell} width={7 * cell} height={7 * cell} rx="6" fill="#18181B" />
              <rect x={fx * cell + cell} y={fy * cell + cell} width={5 * cell} height={5 * cell} rx="4" fill="#F4F4F5" />
              <rect x={fx * cell + 2 * cell} y={fy * cell + 2 * cell} width={3 * cell} height={3 * cell} rx="2.5" fill="#7C3AED" />
            </g>
          ))}
          <rect x={8 * cell} y={8 * cell} width={5 * cell} height={5 * cell} rx="5" fill="#7C3AED" />
          <path
            d={`M${9.4 * cell} ${10.5 * cell}a${1.4 * cell} ${1.4 * cell} 0 1 1 ${2.2 * cell} 0`}
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            transform={`rotate(-90 ${10.5 * cell} ${10.5 * cell})`}
          />
        </g>
        <rect x="124" y="148" width="72" height="7" rx="3.5" fill="#52525B" />
        <path d="M40 58h32M48 90h24M36 122h36" stroke="rgb(196 181 253 / 0.35)" stroke-dasharray="2 5" stroke-linecap="round" />
        <path d="M248 58h32M248 90h24M248 122h36" stroke="rgb(196 181 253 / 0.35)" stroke-dasharray="2 5" stroke-linecap="round" />
      </svg>
    )
  }
</div>

<style>
  .visual {
    aspect-ratio: 305 / 125; /* proporción medida en la referencia */
    border-radius: 0.75rem;
    background:
      radial-gradient(60% 80% at 50% 100%, rgb(139 92 246 / 0.22), transparent 70%),
      radial-gradient(80% 60% at 50% 0%, rgb(139 92 246 / 0.08), transparent 70%),
      #0a0811;
    border: 1px solid rgb(139 92 246 / 0.18);
    box-shadow: inset 0 0 30px -12px rgb(139 92 246 / 0.5);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .visual svg {
    width: 100%;
    height: 100%;
    transition: transform var(--duration-slow) var(--ease-out);
  }
</style>

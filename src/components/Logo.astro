---
import { withBase } from '../lib/paths';
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-symbol.png';

interface Props {
  /** Tamaño del símbolo en px. */
  size?: number;
  /** Muestra el wordmark junto al símbolo. */
  wordmark?: boolean;
  href?: string;
  class?: string;
  /** Nombre accesible del enlace. */
  label?: string;
}

const { size = 34, wordmark = true, href = withBase('/'), class: className, label = 'cLoak Studios — inicio' } = Astro.props;
---

<a href={href} class:list={['logo', className]} aria-label={label}>
  <Image
    src={logoMark}
    alt=""
    width={size}
    height={size}
    densities={[1, 2]}
    format="webp"
    loading="eager"
    class="logo__mark"
  />
  {
    wordmark && (
      <span class="logo__word" aria-hidden="true">
        cLoak<span class="logo__studio">Studios</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 10px;
  }

  .logo__mark {
    flex: none;
  }

  .logo__word {
    font-family: var(--font-brand);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo__studio {
    font-weight: 400;
    color: var(--text);
    margin-left: 0.28em;
  }
</style>

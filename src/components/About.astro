---
import Icon, { type Name } from './Icon.astro';
import Nebula from './Nebula.astro';
import { pillars } from '../data/services';
import { site } from '../data/site';

const { founder } = site;
const firstName = founder.name.split(' ')[0];

const icons: Name[] = ['compass', 'layers', 'spark', 'message'];
const glow = ['135deg', '205deg', '160deg', '225deg'];
---

<section class="space-section about" id="estudio" aria-labelledby="about-title" data-cosmos-anchor="about">
  <Nebula src="left" side="right" top="12%" width="clamp(9rem, 15vw, 18rem)" delay="-13s" />
  <div class="frame">
    <div class="frame__row about__grid">
      <div class="about__intro" data-reveal>
        <p class="eyebrow">Por qué cLoak Studios</p>
        <h2 id="about-title">Tecnología con propósito.</h2>
        <p class="lead">
          Somos un estudio independiente centrado en crear soluciones digitales útiles, claras y bien construidas.
          Combinamos diseño y desarrollo para que la tecnología trabaje a favor de tu negocio.
        </p>
        <blockquote class="about__quote">
          <p>Build beyond the visible.</p>
        </blockquote>

        <aside class="founder neon-card" aria-labelledby="founder-title" style="--glow-angle:150deg">
          <p class="founder__eyebrow">Quién hay detrás</p>
          <h3 id="founder-title" class="founder__name">{founder.name}</h3>
          <p class="founder__role">{founder.role}</p>
          <p class="founder__text">
            Detrás de cLoak Studios está {firstName}, desarrollador full stack. Se encarga de cada proyecto de principio
            a fin: desde la primera conversación hasta el diseño, el desarrollo y la puesta en marcha.
          </p>
          <a class="founder__link" href={founder.portfolioUrl} target="_blank" rel="noopener">
            Ver portafolio
            <Icon name="arrow-right" size={16} />
            <span class="visually-hidden">(se abre en una pestaña nueva)</span>
          </a>
        </aside>
      </div>

      <ul role="list" class="pillars">
        {
          pillars.map((p, i) => (
            <li class="pillar neon-card" data-reveal style={`--reveal-delay:${i * 70}ms;--glow-angle:${glow[i]}`}>
              <span class="icon-box">
                <Icon name={icons[i]} size={18} />
              </span>
              <h3 class="pillar__title">{p.title}</h3>
              <p class="pillar__text">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-10);
  }

  .about__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .about__quote {
    justify-self: start;
    margin: var(--space-4) 0 0;
    padding: 0.55rem 1.1rem;
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-soft-lavender);
    border: 1px solid rgb(139 92 246 / 0.6);
    border-radius: var(--radius-pill);
    background: rgb(139 92 246 / 0.08);
    box-shadow:
      0 0 18px -6px rgb(139 92 246 / 0.7),
      inset 0 0 10px -4px rgb(139 92 246 / 0.5);
  }

  .founder {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: 1.4rem 1.35rem 1.5rem;
  }

  .founder__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(244 244 245 / 0.62);
  }

  .founder__name {
    margin-top: var(--space-1);
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .founder__role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-soft-lavender);
  }

  .founder__text {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(244 244 245 / 0.75);
  }

  .founder__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(139 92 246 / 0.6);
    border-radius: var(--radius-pill);
    background: rgb(139 92 246 / 0.12);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  .founder__link:hover {
    background: rgb(139 92 246 / 0.22);
    box-shadow: var(--glow-neon);
  }

  .pillars {
    display: grid;
    gap: 1.125rem;
  }

  .pillar {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: 1.4rem 1.35rem 1.5rem;
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-slow) var(--ease-out);
  }

  .pillar .icon-box {
    margin-bottom: var(--space-3);
  }

  .pillar__title {
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .pillar__text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(244 244 245 / 0.7);
  }

  .pillar:hover {
    --edge: rgb(167 139 250 / 0.7);
  }

  .pillar:hover::after {
    opacity: 0.95;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .pillar:hover {
      transform: translateY(-4px);
    }
  }

  @media (min-width: 40rem) {
    .pillars {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-12);
      align-items: start;
    }

    .about__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-10));
    }
  }
</style>

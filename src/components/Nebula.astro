---
// Universo fotográfico del diseño de referencia (Diseño/servicios.jpeg):
// franjas laterales sin UI, con bordes ya fundidos en el alfa del recorte.
// Se mezclan en modo `screen` sobre el cielo, así el negro del recorte
// desaparece y no se nota ninguna caja: el fondo es el mismo en toda la página.
// Escala con el ancho de la pantalla igual que en la referencia (1672 px).
// Se coloca dentro de una sección a ancho completo con `position: relative`.
import { Image } from 'astro:assets';
import universeLeft from '../assets/cosmos/universe-left.webp';
import universeRight from '../assets/cosmos/universe-right.webp';

interface Props {
  /** Recorte: franja izquierda (x 0–250) o derecha (x 760–1672) del diseño. */
  src: 'left' | 'right';
  /** Borde de la sección al que se pega. */
  side: 'left' | 'right';
  /** Posición vertical (CSS). */
  top?: string;
  /** Refleja el recorte en vertical para variar entre secciones. */
  flipY?: boolean;
  opacity?: number;
}

const { src, side, top = '0', flipY = false, opacity = 1 } = Astro.props;
const image = src === 'left' ? universeLeft : universeRight;
// Ancho relativo al lienzo de referencia de 1672 px.
const width = ((image.width / 1672) * 100).toFixed(3);
// Si se usa en el lado contrario se refleja para que el borde del encuadre
// original siga tocando el borde de la pantalla.
const flipX = src !== side;
---

<div
  class:list={['nebula', `nebula--${side}`, { 'nebula--flip-x': flipX, 'nebula--flip-y': flipY }]}
  style={`--top:${top};--w:${width}%;--o:${opacity}`}
  aria-hidden="true"
>
  <Image src={image} alt="" quality={92} format="webp" loading="lazy" decoding="async" />
</div>

<style>
  .nebula {
    position: absolute;
    z-index: -1;
    top: var(--top);
    width: var(--w);
    opacity: var(--o);
    pointer-events: none;
    mix-blend-mode: screen;
    /* Fundido arriba y abajo: las franjas de secciones contiguas se solapan sin corte */
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 82%, transparent);
  }

  .nebula--left {
    left: 0;
  }

  .nebula--right {
    right: 0;
  }

  .nebula img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nebula--flip-x img {
    scale: -1 1;
  }

  .nebula--flip-y img {
    scale: 1 -1;
  }

  .nebula--flip-x.nebula--flip-y img {
    scale: -1 -1;
  }

  /* En pantallas estrechas el recorte derecho invadiría el texto: solo el borde. */
  @media (max-width: 48rem) {
    .nebula {
      opacity: calc(var(--o) * 0.75);
    }
  }
</style>

---
// Gráfico abstracto original del hero: capas/cintas que forman una «C» abierta,
// inspiradas en el símbolo de cLoak Studios. Decorativo.
---

<svg class="ribbon" viewBox="0 0 600 600" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="rb-main" x1="120" y1="110" x2="430" y2="500" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#C4B5FD" />
      <stop offset="0.45" stop-color="#8B5CF6" />
      <stop offset="1" stop-color="#4C1D95" />
    </linearGradient>
    <linearGradient id="rb-sheen" x1="110" y1="300" x2="300" y2="300" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity="0.32" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="rb-fold-top" x1="415" y1="196" x2="590" y2="150" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#A78BFA" />
      <stop offset="1" stop-color="#DDD6FE" stop-opacity="0.85" />
    </linearGradient>
    <linearGradient id="rb-fold-bottom" x1="415" y1="404" x2="590" y2="460" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#6D28D9" />
      <stop offset="1" stop-color="#A78BFA" stop-opacity="0.9" />
    </linearGradient>
    <radialGradient id="rb-glow" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(290 300) rotate(90) scale(260)">
      <stop offset="0" stop-color="#8B5CF6" stop-opacity="0.28" />
      <stop offset="1" stop-color="#8B5CF6" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx="290" cy="300" r="260" fill="url(#rb-glow)" />

  <!-- Órbita fina exterior -->
  <path class="ribbon__line" pathLength="1" d="M502.3 153A250 250 0 1 0 502.3 447" stroke="#C4B5FD" stroke-opacity="0.22" stroke-width="1.25" />

  <!-- Cinta principal -->
  <path class="ribbon__band" pathLength="1" d="M441.2 172.9A190 190 0 1 0 441.2 427.1" stroke="url(#rb-main)" stroke-width="70" />
  <path class="ribbon__band" pathLength="1" d="M418.9 192.8A160 160 0 1 0 418.9 407.2" stroke="url(#rb-sheen)" stroke-width="10" />

  <!-- Capa interior -->
  <path class="ribbon__band ribbon__band--late" pathLength="1" d="M395.1 214.4A128 128 0 1 0 395.1 385.6" stroke="#8B5CF6" stroke-opacity="0.35" stroke-width="12" />

  <!-- Pliegues en los extremos -->
  <path class="ribbon__fold" d="M415.2 196.3 467.2 149.4 588 138 528 194Z" fill="url(#rb-fold-top)" />
  <path class="ribbon__fold" d="M415.2 196.3 528 194 503 222Z" fill="#4C1D95" fill-opacity="0.85" />
  <path class="ribbon__fold ribbon__fold--late" d="M415.2 403.7 467.2 450.6 588 466 528 404Z" fill="url(#rb-fold-bottom)" />
  <path class="ribbon__fold ribbon__fold--late" d="M415.2 403.7 528 404 520 380Z" fill="#DDD6FE" fill-opacity="0.35" />
</svg>

<style>
  .ribbon {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ribbon__band,
  .ribbon__line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: ribbon-draw 1.6s var(--ease-out) both;
  }

  .ribbon__line {
    animation-duration: 2.2s;
  }

  .ribbon__band--late {
    animation-delay: 0.25s;
  }

  .ribbon__fold {
    transform-box: fill-box;
    transform-origin: left center;
    animation: ribbon-fold 0.9s var(--ease-out) 0.9s both;
  }

  .ribbon__fold--late {
    animation-delay: 1.05s;
  }

  @keyframes ribbon-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes ribbon-fold {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ribbon__band,
    .ribbon__line,
    .ribbon__fold {
      animation: none;
    }
  }
</style>

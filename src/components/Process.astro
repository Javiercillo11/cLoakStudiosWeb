---
import Nebula from './Nebula.astro';
import { process } from '../data/services';

const glow = ['135deg', '160deg', '200deg', '225deg'];
---

<section class="space-section process" id="proceso" aria-labelledby="process-title" data-cosmos-anchor="process">
  <Nebula src="left" side="right" top="0" flipY />
  <Nebula src="left" side="left" top="40%" />
  <div class="frame">
    <div class="frame__row">
      <header class="process__head" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="process-title">De la idea a una solución<br /> que funciona.</h2>
        <p class="lead">Los plazos y el alcance se concretan en cada propuesta.</p>
      </header>

      <ol role="list" class="steps">
        {
          process.map((step, i) => (
            <li
              class="step neon-card"
              data-reveal
              style={`--reveal-delay:${i * 80}ms;--glow-angle:${glow[i]}`}
            >
              <span class="step__num neon-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process__head {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
  }

  .steps {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 1.375rem;
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }

  .step {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: 1.5rem 1.4rem 1.6rem;
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out);
  }

  .step__num {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: var(--space-4);
  }

  .step__title {
    font-size: 1.125rem;
  }

  .step__text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(244 244 245 / 0.7);
  }

  .step:hover {
    --edge: rgb(167 139 250 / 0.7);
  }

  .step:hover::after {
    opacity: 0.95;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .step:hover {
      transform: translateY(-4px);
    }
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }

    /* Hilo de luz que une los pasos */
    .steps::before {
      content: '';
      position: absolute;
      z-index: -2;
      left: 4%;
      right: 4%;
      top: 3.1rem;
      height: 1px;
      background: linear-gradient(90deg, transparent, #8b5cf6 12%, #c4b5fd 50%, #8b5cf6 88%, transparent);
      box-shadow: 0 0 12px 1px rgb(139 92 246 / 0.7);
    }
  }
</style>

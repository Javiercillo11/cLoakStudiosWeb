---
import { process } from '../data/services';
---

<section class="section process" id="proceso" aria-labelledby="process-title">
  <div class="container">
    <div class="process__layout">
      <header class="process__head" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="process-title">De la idea a una solución que funciona.</h2>
        <p class="process__fine">Los plazos y el alcance se concretan en cada propuesta.</p>
      </header>

      <ol role="list" class="steps">
        {
          process.map((step, i) => (
            <li class="step" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <span class="step__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    background: linear-gradient(180deg, transparent, rgb(24 24 27 / 0.55) 30%, rgb(24 24 27 / 0.55) 70%, transparent);
  }

  .process__layout {
    display: grid;
    gap: var(--space-12);
  }

  .process__head {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .process__fine {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .steps {
    counter-reset: step;
    display: grid;
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }

  .step:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .step__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-violet-text);
    padding-top: 0.3rem;
  }

  .step__title {
    font-size: var(--text-xl);
  }

  .step__text {
    margin-top: var(--space-2);
    color: var(--text-muted);
  }

  /* Línea de progreso violeta que se ilumina al pasar sobre cada paso */
  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3.25rem;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .step:hover::before,
  .step.is-visible::before {
    transform: scaleX(1);
  }

  @media (min-width: 56rem) {
    .process__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: var(--space-16);
    }

    .process__head {
      position: sticky;
      top: calc(var(--header-height) + var(--space-10));
    }

    .step {
      grid-template-columns: 5rem 1fr;
      padding-block: var(--space-8);
    }

    .step::before {
      width: 5rem;
    }

    .step__num {
      font-size: var(--text-base);
    }
  }
</style>

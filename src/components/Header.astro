---
import { isHomePath } from '../lib/paths';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getLang, homePath, ui, type Lang } from '../i18n/ui';

const lang = getLang(Astro);
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
// En páginas internas, los anclajes apuntan a la portada de su idioma.
const isHome = isHomePath(Astro.url.pathname);
const link = (href: string) => (isHome ? href : `${homePath(lang)}${href}`);
---

<header class="site-header" data-header data-menu-open-label={t.menuOpen} data-menu-close-label={t.menuClose}>
  <div class="frame">
   <div class="frame__row site-header__inner">
    <Logo href={link('#inicio')} size={32} label={t.logoLabel} />

    <nav class="site-nav" aria-label={t.navLabel}>
      <ul role="list" class="site-nav__list">
        {
          t.nav.map((item) => (
            <li>
              <a href={link(item.href)} class="site-nav__link" data-nav-link={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={link('#contacto')} class="header-cta">
        {t.headerCta}
        <Icon name="arrow-right" size={16} />
      </a>
      <!-- Selector de idioma: lleva a la misma sección en el otro idioma -->
      <a
        href={homePath(other)}
        class="lang-switch"
        hreflang={other}
        lang={other}
        aria-label={t.langSwitchTo}
        data-lang-switch
      >
        <span class:list={['lang-switch__opt', { 'is-active': lang === 'es' }]} aria-hidden="true">ES</span>
        <span class:list={['lang-switch__opt', { 'is-active': lang === 'en' }]} aria-hidden="true">EN</span>
      </a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="visually-hidden" data-menu-label>{t.menuOpen}</span>
        <Icon name="menu" size={22} class="menu-toggle__open" />
        <Icon name="close" size={22} class="menu-toggle__close" />
      </button>
    </div>
   </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav aria-label={t.mobileNavLabel} class="container">
      <ul role="list" class="mobile-menu__list">
        {
          t.nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={link(item.href)} class="mobile-menu__link">
                <span class="mobile-menu__index" aria-hidden="true">
                  0{i + 1}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={link('#contacto')} class="mobile-menu__cta">
        {t.hero.tellUs}
        <Icon name="arrow-right" size={18} />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const desktop = window.matchMedia('(min-width: 56rem)');

  const setOpen = (open: boolean, { restoreFocus = false } = {}) => {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = (open ? header.dataset.menuCloseLabel : header.dataset.menuOpenLabel) ?? '';
    menu.hidden = !open;
    header.classList.toggle('is-menu-open', open);
    document.documentElement.classList.toggle('menu-locked', open);
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
    else if (restoreFocus) toggle.focus();
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  // Cerrar al navegar, con Escape y al pasar a desktop.
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setOpen(false, { restoreFocus: true });
  });
  desktop.addEventListener('change', (e) => e.matches && setOpen(false));

  // Mantener el foco dentro del menú abierto (botón + enlaces).
  header.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || menu.hidden) return;
    const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // El selector de idioma abre la otra versión en la sección que se está viendo
  // (la del enlace activo del menú), no en la del último #ancla de la URL.
  header.querySelector<HTMLAnchorElement>('[data-lang-switch]')?.addEventListener('click', (e) => {
    const a = e.currentTarget as HTMLAnchorElement;
    const active = header.querySelector<HTMLAnchorElement>('[data-nav-link].is-active')?.dataset.navLink;
    const base = a.href.split('#')[0];
    a.href = active && active !== '#inicio' && window.scrollY > 80 ? base + active : base;
  });

  // Enlace activo según la sección visible (solo en la portada).
  const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.getElementById(a.dataset.navLink!.slice(1)))
    .filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const setActive = () => {
      const y = window.scrollY + window.innerHeight * 0.35;
      let current = sections[0];
      for (const s of sections) if (s.offsetTop <= y) current = s;
      for (const a of links) {
        const on = a.dataset.navLink === `#${current.id}`;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };
    setActive();
    window.addEventListener('scroll', setActive, { passive: true });
    window.addEventListener('resize', setActive, { passive: true });
  }

  // Fondo del header al hacer scroll.
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease,
      backdrop-filter var(--duration-base) ease;
  }

  .site-header.is-scrolled,
  .site-header.is-menu-open {
    background: rgb(6 5 11 / 0.5);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: rgb(244 244 245 / 0.04);
  }

  .site-header__inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .site-header .frame {
    padding-inline: var(--frame-pad);
  }

  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .site-nav__link {
    display: block;
    padding: var(--space-2) 0.8125rem;
    font-size: 0.765rem;
    color: #c4c3c8;
    text-decoration: none;
    border-radius: 8px;
    transition: color var(--duration-fast) ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: #fff;
  }

  /* Indicador violeta bajo el enlace activo (como en el diseño) */
  .site-nav__link {
    position: relative;
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.2rem;
    width: 1.5rem;
    height: 2px;
    translate: -50% 0;
    border-radius: 2px;
    background: #8b5cf6;
    box-shadow: 0 0 8px rgb(139 92 246 / 0.8);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header-cta {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0 0.7rem 0 0.95rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    background: rgb(16 6 40 / 0.6);
    border: 1px solid #7a3cf0;
    border-radius: var(--radius-pill);
    box-shadow:
      0 0 16px -4px rgb(139 92 246 / 0.6),
      inset 0 0 10px -4px rgb(139 92 246 / 0.5);
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .header-cta:hover {
    border-color: var(--color-soft-lavender);
    background: rgb(139 92 246 / 0.16);
  }

  .header-cta :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .header-cta:hover :global(svg) {
    transform: translateX(2px);
  }

  /* Selector de idioma: píldora con la opción activa iluminada */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 2.25rem;
    padding: 3px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    background: rgb(16 6 40 / 0.6);
    border-radius: var(--radius-pill);
  }

  .lang-switch__opt {
    display: grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.75rem;
    border-radius: var(--radius-pill);
    color: rgb(244 244 245 / 0.55);
    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .lang-switch:hover .lang-switch__opt:not(.is-active) {
    color: var(--text);
  }

  .lang-switch__opt.is-active {
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #6d28d9);
    box-shadow: 0 0 12px -2px rgb(139 92 246 / 0.8);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  .menu-toggle :global(.menu-toggle__close),
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: block;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height) 0 0;
    background: var(--bg);
    padding-block: var(--space-8);
    overflow-y: auto;
  }

  .mobile-menu__list {
    display: grid;
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
    animation: menu-in var(--duration-base) var(--ease-out) both;
    animation-delay: calc(var(--i) * 40ms);
  }

  .mobile-menu__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-violet-text);
  }

  .mobile-menu__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    padding: 0.9rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-violet-strong);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  :global(html.menu-locked) {
    overflow: hidden;
  }

  @media (min-width: 40rem) {
    .header-cta {
      display: inline-flex;
    }
  }

  @media (min-width: 56rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header__actions {
      justify-self: end;
    }
    /* La referencia desplaza la navegación ~10 px a la derecha del centro */
    .site-nav {
      padding-left: 1.25rem;
    }
    .site-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>

---
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import photoWeb from '../assets/services/web.webp';
import photoApp from '../assets/services/app.webp';
import photoQr from '../assets/services/qr.webp';
import Nebula from './Nebula.astro';
import { services } from '../data/services';

// Fotos de cada tarjeta (recortes de Diseño/servicios.jpeg).
const photos = { web: photoWeb, app: photoApp, qr: photoQr } as const;

// Ángulo del reflejo neón del borde de cada tarjeta (como en el diseño).
const glow = ['135deg', '160deg', '205deg'];
---

<section class="services" id="servicios" aria-labelledby="services-title" data-cosmos-anchor="services">
  <!-- Mismo encuadre que la referencia: el título queda a y≈130 de 941 px -->
  <Nebula src="left" side="left" top="calc(4.5rem - 7.8vw)" />
  <Nebula src="right" side="right" top="calc(4.5rem - 7.8vw)" />
  <div class="frame">
    <div class="frame__row">
      <header class="services__head" data-reveal>
        <h2 id="services-title">Soluciones digitales para<br class="br-wide" /> hacer crecer tu negocio.</h2>
        <p class="services__lead">
          Diseñamos y desarrollamos herramientas digitales que<br class="br-wide" /> impulsan necesidades reales de tu negocio.
        </p>
      </header>

      <ul role="list" class="services__grid">
        {
          services.map((s, i) => (
            <li
              class:list={['card neon-card', { 'card--featured': i === 0 }]}
              id={s.slug}
              data-reveal
              style={`--reveal-delay:${i * 90}ms;--glow-angle:${glow[i] ?? '135deg'}`}
            >
              <div class="card__photo">
                <Image src={photos[s.id]} alt="" widths={[316, 632]} sizes="(min-width: 60rem) 20rem, 100vw" quality={88} format="webp" loading="lazy" decoding="async" />
              </div>
              <div class="card__body">
                <div class="card__head">
                  <span class="icon-box">
                    <Icon name={s.icon} size={18} />
                  </span>
                  <span class="card__num">{s.number}</span>
                </div>
                <h3 class="card__title">
                  {s.titleLines[0]}
                  <br />
                  {s.titleLines[1]}
                </h3>
                <p class="card__desc">{s.description}</p>
                <p class="card__list-title">{s.listTitle}</p>
                <ul role="list" class="card__list">
                  {s.items.map((item) => (
                    <li>
                      <Icon name="check" size={14} />
                      {item}
                    </li>
                  ))}
                </ul>
                <a class="card__cta" href={`?servicio=${s.id}#contacto`} data-service-link={s.id}>
                  {s.cta}
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 4.5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .services__lead {
    margin-top: var(--space-3);
    max-width: 34rem;
    font-size: var(--text-base);
    color: rgb(244 244 245 / 0.68);
  }

  .br-wide {
    display: none;
  }

  .services__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(1.75rem, 1.25rem + 1.5vw, 2.25rem);
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 0.7rem;
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) ease,
      opacity var(--duration-slow) var(--ease-out);
  }

  .card--featured {
    --edge: rgb(139 92 246 / 0.6);
  }

  .card--featured::after {
    opacity: 0.8;
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.5rem 1.15rem 0.15rem;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__num {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: rgb(244 244 245 / 0.7);
  }

  .card__title {
    margin-top: 0.45rem;
    font-family: var(--font-brand);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.005em;
    text-wrap: initial;
  }

  .card__desc {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.48;
    color: rgb(244 244 245 / 0.7);
  }

  .card__list-title {
    margin-top: 0.8rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(244 244 245 / 0.62);
  }

  .card__list {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.4rem;
    font-size: 0.72rem;
    line-height: 1.38;
    color: rgb(244 244 245 / 0.9);
  }

  .card__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .card__list :global(svg) {
    margin-top: 0.15em;
    color: var(--color-violet-text);
  }

  .card__note {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: rgb(244 244 245 / 0.45);
  }

  .card__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding: 0.5rem 1.1rem 0.5rem 1.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    background: rgb(9 9 11 / 0.4);
    border: 1px solid rgb(196 181 253 / 0.3);
    border-radius: var(--radius-pill);
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      box-shadow var(--duration-base) ease;
  }

  .card:hover .card__cta {
    background: linear-gradient(135deg, var(--color-electric) 0%, #7734fd 50%, var(--color-electric-deep) 100%);
    border-color: rgb(167 139 250 / 0.6);
    box-shadow: var(--glow-neon);
  }

  /* Espacio mínimo entre el contenido y el CTA (el CTA siempre queda abajo) */
  .card__body > :nth-last-child(2) {
    margin-bottom: 1.25rem;
  }

  /* Toda la tarjeta es clicable a través del enlace (un único punto de foco). */
  .card__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.125rem;
  }

  .card__cta :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    --edge: rgb(167 139 250 / 0.7);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 30px 60px -30px rgb(0 0 0 / 0.9),
      0 0 56px -14px rgb(139 92 246 / 0.75);
  }

  .card:hover::after {
    opacity: 0.95;
  }

  .card:hover .card__cta :global(svg) {
    transform: translateX(3px);
  }

  .card:has(.card__cta:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .card__cta:focus-visible {
    outline: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-4px);
    }
  }

  @media (min-width: 40rem) {
    .br-wide {
      display: inline;
    }
  }

  /* Móvil: el texto compacto de la referencia se agranda para leerse bien */
  @media (max-width: 39.99rem) {
    .card__desc {
      font-size: 0.875rem;
    }
    .card__list,
    .card__note {
      font-size: 0.8125rem;
    }
    .card__cta {
      font-size: 0.875rem;
      padding-block: 0.65rem;
    }
  }

  /* Pantallas muy estrechas: el CTA ocupa el ancho y no se parte en dos líneas */
  @media (max-width: 23.99rem) {
    .card__cta {
      align-self: stretch;
      justify-content: space-between;
      white-space: nowrap;
      padding-inline: 1rem;
    }
  }

  @media (min-width: 40rem) and (max-width: 59.99rem) {
    /* Tablet: ilustración a la izquierda y contenido a la derecha */
    .card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
    }

    .card > .card__photo {
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
    }

    .card__body {
      padding-top: 0.6rem;
    }
  }

  /* Foto de la tarjeta: se funde por abajo con el cristal, el icono la solapa */
  .card__photo {
    position: relative;
    overflow: hidden;
    border-radius: 0.7rem 0.7rem 0.35rem 0.35rem;
    aspect-ratio: 316 / 164;
  }

  .card__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card__photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, rgb(16 12 30 / 0.85));
  }

  .card:hover .card__photo :global(img) {
    transform: scale(1.03);
  }

  .card__head {
    position: relative;
    z-index: 1;
    margin-top: -1rem;
  }

  /* Caja de icono rellena, como en el diseño */
  .card .icon-box {
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    color: #fff;
    background: linear-gradient(160deg, #6d3ff0, #4c1fb8);
    border: 1px solid rgb(167 139 250 / 0.7);
    box-shadow: 0 0 14px -4px rgb(139 92 246 / 0.9);
  }

  .card__num {
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: rgb(244 244 245 / 0.82);
  }

  /* Todas las tarjetas con el borde neón intenso de la referencia */
  .card {
    --edge: rgb(150 108 250 / 0.85);
  }

  .card::after {
    opacity: 0.75;
  }

  .card__list-title {
    letter-spacing: 0.08em;
    color: rgb(244 244 245 / 0.78);
  }

  .card__list :global(svg) {
    color: #a37cfa;
    stroke-width: 2;
  }

  @media (min-width: 60rem) {
    /*
     * --s = 1 px de Diseño/servicios.jpeg (la cabecera mide 1103 px, x 240–1343,
     * y aquí ocupa la fila de contenido).
     */
    .services {
      --s: calc(min(100vw - var(--frame-pad) * 2, var(--row-max)) / 1103);
    }

    .services__head h2 {
      font-size: calc(42 * var(--s));
      line-height: calc(47 / 43);
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .services__lead {
      margin-top: calc(16 * var(--s));
      max-width: none;
      font-size: calc(18 * var(--s));
      line-height: calc(27.5 / 18);
      color: rgb(244 244 245 / 0.8);
    }

    .services__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: calc(26 * var(--s));
      margin-top: calc(32 * var(--s));
    }

    .card {
      padding: calc(10 * var(--s));
      border-radius: calc(15 * var(--s));
    }

    .card__photo {
      aspect-ratio: auto;
      height: calc(164 * var(--s));
    }

    .card__body {
      padding: 0 calc(14 * var(--s)) calc(12 * var(--s));
    }

    .card__head {
      margin-top: calc(-17 * var(--s));
    }

    .card .icon-box {
      width: calc(32 * var(--s));
      height: calc(32 * var(--s));
      border-radius: calc(7 * var(--s));
    }

    .card .icon-box :global(svg) {
      width: calc(18 * var(--s));
      height: calc(18 * var(--s));
    }

    .card__num {
      font-size: calc(14 * var(--s));
    }

    .card__title {
      margin-top: calc(10 * var(--s));
      font-family: var(--font-body);
      font-size: calc(21.5 * var(--s));
      line-height: calc(24.5 / 21.5);
      font-weight: 600;
      letter-spacing: -0.015em;
    }

    .card__desc {
      margin-top: calc(11 * var(--s));
      font-size: calc(14.2 * var(--s));
      line-height: calc(19.5 / 14.2);
      letter-spacing: -0.012em;
      color: rgb(244 244 245 / 0.74);
    }

    .card__list-title {
      margin-top: calc(18 * var(--s));
      font-size: calc(11.5 * var(--s));
    }

    .card__list {
      gap: calc(8 * var(--s));
      margin-top: calc(13 * var(--s));
      font-size: calc(13.4 * var(--s));
      line-height: calc(16 / 13.4);
      letter-spacing: -0.012em;
    }

    .card__list li {
      gap: calc(16 * var(--s));
    }

    .card__list :global(svg) {
      width: calc(17 * var(--s));
      height: calc(17 * var(--s));
      margin-top: 0;
    }

    .card__cta {
      min-height: calc(38 * var(--s));
      padding: 0 calc(18 * var(--s));
      gap: calc(14 * var(--s));
      font-size: calc(13.8 * var(--s));
      font-weight: 500;
    }

    .card__body > :nth-last-child(2) {
      margin-bottom: calc(40 * var(--s));
    }
  }
</style>

---
import Icon from './Icon.astro';
import ServiceVisual from './ServiceVisual.astro';
import { services } from '../data/services';
---

<section class="section services" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">Servicios</p>
      <h2 id="services-title">Soluciones digitales para hacer crecer tu negocio.</h2>
      <p class="lead">Diseñamos y desarrollamos herramientas digitales que resuelven necesidades reales de tu negocio.</p>
    </header>

    <ul role="list" class="services__grid">
      {
        services.map((s, i) => (
          <li class="card" id={s.slug} data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <ServiceVisual id={s.id} />
            <div class="card__head">
              <span class="card__icon">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="card__num">{s.number}</span>
            </div>
            <h3 class="card__title">{s.title}</h3>
            <p class="card__desc">{s.description}</p>
            <p class="card__list-title">{s.listTitle}</p>
            <ul role="list" class="card__list">
              {s.items.map((item) => (
                <li>
                  <Icon name="check" size={16} />
                  {item}
                </li>
              ))}
            </ul>
            {s.note && <p class="card__note">{s.note}</p>}
            <a
              class="card__cta"
              href={`?servicio=${s.id}#contacto`}
              data-service-link={s.id}
            >
              {s.cta}
              <Icon name="arrow-right" size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-head {
    display: grid;
    gap: var(--space-5);
    max-width: 44rem;
  }

  .services__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-3) var(--space-3) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition:
      border-color var(--duration-base) ease,
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-slow) var(--ease-out);
  }

  .card > :not(:global(.visual)) {
    margin-inline: var(--space-3);
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-6);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.8rem;
    color: var(--color-soft-lavender);
    background: rgb(139 92 246 / 0.1);
    border: 1px solid rgb(139 92 246 / 0.25);
  }

  .card__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--text-muted);
  }

  .card__title {
    margin-top: var(--space-5);
    font-size: var(--text-xl);
  }

  .card__desc {
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  .card__list-title {
    margin-top: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
  }

  .card__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .card__list :global(svg) {
    margin-top: 0.2em;
    color: var(--color-violet-text);
  }

  .card__note {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-line-strong);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding: 0.85rem 1.1rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-control);
    transition:
      background-color var(--duration-fast) ease,
      border-color var(--duration-fast) ease;
  }

  /* Espacio mínimo entre el contenido y el CTA (el CTA siempre queda abajo) */
  .card > :nth-last-child(2) {
    margin-bottom: var(--space-8);
  }

  /* Toda la tarjeta es clicable a través del enlace (un único punto de foco). */
  .card__cta::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card__cta :global(svg) {
    color: var(--color-soft-lavender);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .card:hover {
    border-color: rgb(139 92 246 / 0.45);
  }

  .card:hover .card__cta {
    background: var(--color-violet-strong);
    border-color: var(--color-violet-strong);
  }

  .card:hover .card__cta :global(svg) {
    color: #fff;
    transform: translateX(3px);
  }

  .card:hover :global(.visual svg) {
    transform: scale(1.025);
  }

  .card:has(.card__cta:focus-visible) {
    border-color: var(--color-soft-lavender);
  }

  .card__cta:focus-visible {
    outline-offset: 2px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover {
      transform: translateY(-3px);
    }
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    /* Tablet: ilustración a la izquierda y contenido a la derecha */
    .card {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      grid-auto-rows: min-content;
      column-gap: var(--space-6);
      padding: var(--space-3) var(--space-6) var(--space-6) var(--space-3);
    }

    .card > :global(.visual) {
      grid-row: 1 / span 8;
      align-self: start;
      position: sticky;
      top: calc(var(--header-height) + var(--space-4));
    }

    .card > :not(:global(.visual)) {
      grid-column: 2;
      margin-inline: 0;
    }

    .card__cta {
      margin-top: var(--space-8) !important;
      justify-self: start;
    }
  }

  @media (min-width: 64rem) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

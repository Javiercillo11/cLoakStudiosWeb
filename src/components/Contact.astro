---
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import Nebula from './Nebula.astro';
import { site } from '../data/site';

const next = [
  'Revisamos tu solicitud y el servicio que has elegido.',
  'Te escribimos al email que nos indiques para concretar detalles.',
  'Si encaja, preparamos una propuesta con alcance y plazos.',
];
---

<section class="space-section contact" id="contacto" aria-labelledby="contact-title" data-cosmos-anchor="contact">
  <Nebula src="right" side="right" top="4%" width="clamp(11rem, 20vw, 24rem)" delay="-6s" />
  <Nebula src="left" side="left" top="48%" width="clamp(8rem, 12vw, 15rem)" opacity={0.85} delay="-17s" />
  <div class="frame">
  <div class="frame__row contact__grid">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow">Contacto</p>
      <h2 id="contact-title">Hablemos de tu proyecto.</h2>
      <p class="lead">
        Cuéntanos qué necesitas. Revisaremos tu solicitud y nos pondremos en contacto contigo para hablar de los
        siguientes pasos.
      </p>

      <div class="contact__next">
        <p class="contact__next-title">Qué pasa después</p>
        <ol role="list">
          {
            next.map((t, i) => (
              <li>
                <span class="neon-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {t}
              </li>
            ))
          }
        </ol>
      </div>

      {
        site.email && (
          <a class="contact__mail" href={`mailto:${site.email}`}>
            <Icon name="mail" size={20} />
            {site.email}
          </a>
        )
      }
    </div>

    <div class="contact__panel neon-card" data-reveal style="--reveal-delay:120ms;--glow-angle:205deg">
      <ContactForm />
    </div>
  </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-12);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .contact__next {
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(139 92 246 / 0.25);
  }

  .contact__next-title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(244 244 245 / 0.62);
  }

  .contact__next ol {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .contact__next li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    color: rgb(244 244 245 / 0.78);
    font-size: var(--text-sm);
  }

  .contact__next li span {
    font-size: 1rem;
  }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2.5vw, 2.25rem);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-16);
      align-items: start;
    }

    .contact__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-10));
    }
  }
</style>

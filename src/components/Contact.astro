---
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
import Nebula from './Nebula.astro';
import OrbitLink from './OrbitLink.astro';
import { site } from '../data/site';
import { whatsappUrl } from '../lib/whatsapp';
import { getLang, ui } from '../i18n/ui';

const lang = getLang(Astro);
const t = ui[lang].contact;
const whatsapp = whatsappUrl(site.whatsapp.phone, ui[lang].whatsapp.message);
const next = t.next;
---

<section class="space-section contact" id="contacto" aria-labelledby="contact-title" data-cosmos-anchor="contact">
  <Nebula src="left" side="left" top="-4%" flipY opacity={0.85} depth={0.12} />
  <OrbitLink side="right" top="-6rem" delay="-6s" />
  <div class="frame">
  <div class="frame__row contact__grid">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="contact-title">{t.title}</h2>
      <p class="lead">{t.lead}</p>

      <div class="contact__next">
        <p class="contact__next-title">{t.nextTitle}</p>
        <ol role="list">
          {
            next.map((item, i) => (
              <li>
                <span class="neon-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {item}
              </li>
            ))
          }
        </ol>
      </div>

      {
        (site.email || whatsapp) && (
          <div class="contact__direct">
            {site.email && (
              <a class="contact__mail" href={`mailto:${site.email}`}>
                <Icon name="mail" size={20} />
                {site.email}
              </a>
            )}
            {whatsapp && (
              <p class="contact__wa">
                {t.whatsappPrompt}{' '}
                <a href={whatsapp} target="_blank" rel="noopener">
                  {t.whatsappLink}<span class="visually-hidden"> {ui[lang].about.newTab}</span>
                </a>
              </p>
            )}
          </div>
        )
      }
    </div>

    <div class="contact__panel neon-card" data-reveal style="--reveal-delay:120ms;--glow-angle:205deg">
      <ContactForm />
    </div>
  </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-12);
  }

  .contact__intro {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .contact__next {
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(139 92 246 / 0.25);
  }

  .contact__next-title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(244 244 245 / 0.62);
  }

  .contact__next ol {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .contact__next li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    color: rgb(244 244 245 / 0.78);
    font-size: var(--text-sm);
  }

  .contact__next li span {
    font-size: 1rem;
  }

  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .contact__direct {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .contact__direct .contact__mail {
    margin-top: 0;
  }

  .contact__wa {
    color: rgb(244 244 245 / 0.72);
    font-size: var(--text-sm);
  }

  .contact__wa a {
    color: var(--color-soft-lavender);
    font-weight: 500;
  }

  .contact__panel {
    padding: clamp(1.25rem, 0.8rem + 2.5vw, 2.25rem);
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-16);
      align-items: start;
    }

    .contact__intro {
      position: sticky;
      top: calc(var(--header-height) + var(--space-10));
    }
  }
</style>

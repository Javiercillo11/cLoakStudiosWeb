---
import { withBase } from '../lib/paths';
import '../styles/form.css';
import Field from './form/Field.astro';
import ChoiceGroup from './form/ChoiceGroup.astro';
import Icon from './Icon.astro';
import { LIMITS, MESSAGE_MIN, SERVICE_IDS } from '../lib/contact/schema';
import { getLang, ui } from '../i18n/ui';
import { resolveMode, supabaseTarget, WEB3FORMS_ENDPOINT } from '../lib/contact/submit';

const accessKey = (import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '').trim();
const hasSupabase = !!supabaseTarget(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
const mode = resolveMode({ web3forms: !!accessKey, supabase: hasSupabase }, import.meta.env.DEV);

if (!import.meta.env.DEV) {
  if (mode === 'disabled') {
    console.warn('\n[contacto] No hay ningún canal de envío configurado: el formulario se publicará desactivado.\n');
  } else {
    if (!accessKey) console.warn('\n[contacto] Falta PUBLIC_WEB3FORMS_ACCESS_KEY: las solicitudes no llegarán por email.\n');
    if (!hasSupabase) console.warn('\n[contacto] Faltan PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY: las solicitudes no llegarán a la app.\n');
  }
}

const lang = getLang(Astro);
const tf = ui[lang].form;
const OPTIONS = tf.options;
---

<form
  class="contact-form"
  id="contact-form"
  data-contact-form
  data-mode={mode}
  data-lang={lang}
  method="post"
  action={mode === 'live' && accessKey ? WEB3FORMS_ENDPOINT : undefined}
  aria-labelledby="contact-title"
>
  {
    mode === 'test' && (
      <div class="notice notice--test" role="note">
        <span class="notice__tag">{tf.testTag}</span>
        <p set:html={tf.testNotice} />
      </div>
    )
  }
  {
    mode === 'disabled' && (
      <div class="notice notice--warn" role="note">
        <Icon name="alert" size={20} />
        <p>{tf.disabledNotice}</p>
      </div>
    )
  }

  {
    mode === 'live' && accessKey && (
      <>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="Nueva solicitud desde cLoak Studios" />
      </>
    )
  }

  <!-- 1. Servicio -->
  <fieldset class="service-picker" id="cf-service" aria-describedby="cf-service-error" data-field="cf-service">
    <legend class="field__label">
      <span>{tf.serviceLegend}</span>
      <span class="field__req">{tf.required}</span>
    </legend>
    <div class="service-picker__grid">
      {
        SERVICE_IDS.map((id) => (
          <label class="service-option">
            <input type="radio" name="service" value={id} required class="service-option__input" />
            <span class="service-option__dot" aria-hidden="true" />
            <span class="service-option__text">
              <span class="service-option__title">{tf.serviceLabels[id]}</span>
              <span class="service-option__hint">{tf.serviceHints[id]}</span>
            </span>
          </label>
        ))
      }
    </div>
    <p class="field__error" id="cf-service-error" data-error-for="cf-service" hidden></p>
  </fieldset>

  <!-- 2. Datos de contacto -->
  <div class="form-grid">
    <Field id="cf-name" name="name" label={tf.name} required autocomplete="name" maxlength={LIMITS.name} />
    <Field
      id="cf-business"
      name="business"
      label={tf.business}
      conditionalRequired
      autocomplete="organization"
      maxlength={LIMITS.business}
    />
    <Field
      id="cf-email"
      name="email"
      label={tf.email}
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      maxlength={LIMITS.email}
      placeholder={tf.emailPlaceholder}
    />
    <Field
      id="cf-phone"
      name="phone"
      label={tf.phone}
      type="tel"
      autocomplete="tel"
      inputmode="tel"
      maxlength={LIMITS.phone}
    />
  </div>

  <!-- 3. Bloques dinámicos por servicio -->
  <fieldset class="service-block" data-service-block="web">
    <legend class="service-block__legend">{tf.webLegend}</legend>
    <div class="service-block__body">
      <ChoiceGroup name="web_has_site" legend={tf.webHasSite} type="radio" options={OPTIONS.webHasSite} />
      <ChoiceGroup name="web_needs" legend={tf.webNeeds} type="checkbox" options={OPTIONS.webNeeds} />
      <div class="form-grid">
        <Field
          id="cf-web-type"
          name="web_business_type"
          label={tf.webType}
          maxlength={LIMITS.webBusinessType}
          placeholder={tf.webTypePlaceholder}
        />
        <Field
          id="cf-web-url"
          name="web_current_url"
          label={tf.webUrl}
          type="url"
          inputmode="url"
          autocomplete="url"
          maxlength={LIMITS.url}
          placeholder={tf.webUrlPlaceholder}
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="service-block" data-service-block="app">
    <legend class="service-block__legend">{tf.appLegend}</legend>
    <div class="service-block__body">
      <ChoiceGroup name="app_manage" legend={tf.appManage} type="checkbox" options={OPTIONS.appManage} />
      <ChoiceGroup name="app_users" legend={tf.appUsers} type="radio" options={OPTIONS.appUsers} />
      <Field
        id="cf-app-tool"
        name="app_current_tool"
        label={tf.appTool}
        maxlength={LIMITS.appCurrentTool}
        placeholder={tf.appToolPlaceholder}
      />
      <Field
        id="cf-app-simplify"
        name="app_simplify"
        label={tf.appSimplify}
        type="textarea"
        rows={3}
        maxlength={LIMITS.appSimplify}
      />
    </div>
  </fieldset>

  <fieldset class="service-block" data-service-block="qr">
    <legend class="service-block__legend">{tf.qrLegend}</legend>
    <div class="service-block__body">
      <Field
        id="cf-qr-url"
        name="qr_review_url"
        label={tf.qrUrl}
        type="url"
        inputmode="url"
        maxlength={LIMITS.url}
        placeholder="https://…"
        hint={tf.qrUrlHint}
      />
      <ChoiceGroup name="qr_platform" legend={tf.qrPlatform} type="radio" options={OPTIONS.qrPlatform} />
      <ChoiceGroup name="qr_placement" legend={tf.qrPlacement} type="checkbox" options={OPTIONS.qrPlacement} />
    </div>
  </fieldset>

  <!-- 4. Descripción -->
  <Field
    id="cf-message"
    name="message"
    label={tf.message}
    type="textarea"
    required
    rows={5}
    minlength={MESSAGE_MIN}
    maxlength={LIMITS.message}
    counter
    placeholder={tf.messagePlaceholder}
  />

  <!-- Honeypot anti-spam: invisible para personas y tecnologías de apoyo -->
  <div class="hp" aria-hidden="true">
    <label for="cf-botcheck">{tf.honeypot}</label>
    <input type="checkbox" id="cf-botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <!-- 5. Privacidad -->
  <div class="consent" data-field="cf-privacy">
    <label class="consent__label">
      <input
        type="checkbox"
        id="cf-privacy"
        name="privacy"
        required
        aria-required="true"
        aria-describedby="cf-privacy-error"
        class="consent__input"
      />
      <span class="consent__box" aria-hidden="true"><Icon name="check" size={14} /></span>
      <span>
        {tf.privacyPre} <a href={withBase('/privacidad')} target="_blank" rel="noopener">{tf.privacyLink}</a>.{' '}
        <span class="field__req">{tf.required}</span>
      </span>
    </label>
    <p class="field__error" id="cf-privacy-error" data-error-for="cf-privacy" hidden></p>
  </div>

  <!-- Estado del envío (anunciado por lectores de pantalla) -->
  <div class="form-alert" data-form-alert role="alert" hidden></div>

  <div class="form-actions">
    <button type="submit" class="submit" data-submit disabled={mode === 'disabled'}>
      <span class="submit__spinner" aria-hidden="true"></span>
      <span data-submit-label>{tf.submit}</span>
      <Icon name="arrow-right" size={18} />
    </button>
    <p class="form-microcopy">
      {tf.microcopy}{' '}
      <a href={withBase('/privacidad')} target="_blank" rel="noopener">{tf.privacyLink}</a>.
    </p>
  </div>
</form>

<!-- Confirmación: solo se muestra tras la respuesta afirmativa del servicio de envío -->
<div class="form-success" data-form-success tabindex="-1" hidden>
  <span class="form-success__icon" aria-hidden="true"><Icon name="check" size={26} /></span>
  <p class="form-success__tag" data-success-test hidden>{tf.successTest}</p>
  <h3 class="form-success__title">{tf.successTitle}</h3>
  <p>{tf.successText}</p>
  <button type="button" class="btn-reset" data-form-reset>{tf.successAgain}</button>
</div>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
